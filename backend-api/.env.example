# Template de variables de entorno para backend-api
# Copia este archivo a .env y ajusta según tu entorno

# Entorno
APP_ENV=development
APP_DEBUG=true

# Base de datos principal
DB_HOST=localhost
DB_PORT=1433
DB_NAME=Automercado
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DRIVER=ODBC Driver 17 for SQL Server

# Segunda conexión (ej. DataWarehouse o POS)
DB2_HOST=localhost
DB2_PORT=1433
DB2_NAME=Automercado_DW
DB2_USER=sa
DB2_PASSWORD=YourStrong!Passw0rd
DB2_DRIVER=ODBC Driver 17 for SQL Server

# API
API_TITLE=Verificador Precios Luz
API_VERSION=1.0.0
