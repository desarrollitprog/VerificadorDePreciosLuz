<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_logo"
    tools:context=".ui.scanner.ScanActivity">

    <!-- Indicador de progreso de backup (esquina superior izquierda) -->
    <FrameLayout
        android:id="@+id/progressContainer"
        android:layout_width="90dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|top"
            android:text="@string/progress_percent_default"
            android:textSize="11sp"
            android:textColor="@android:color/black"
            android:background="@android:color/transparent" />
    </FrameLayout>

    <!-- Cámara activa, oculta (1dp) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Panel de prueba (emulador): oculto por defecto; togglear tocando el título -->
    <LinearLayout
        android:id="@+id/mockPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:alpha="0"
        android:background="#00FFFFFF"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <EditText
            android:id="@+id/etMockCode"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:autofillHints=""
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/hint_mock_code"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnMockScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/btn_mock_scan" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivLogoLuz"
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerInside"
        android:src="@drawable/logo_luz"
        app:layout_constraintBottom_toTopOf="@+id/messageBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        tools:src="@mipmap/ic_launcher" />

    <!-- Indicador de modo offline (se muestra cuando no hay conexión) -->
    <TextView
        android:id="@+id/tvOfflineIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/offline_indicator"
        android:textColor="#B00020"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Última actualización del respaldo local -->
    <TextView
        android:id="@+id/tvOfflineUpdated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:textColor="#B00020"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvOfflineIndicator" />

    <!-- Indicador de tasa BCV (centrado arriba con icono) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardDolarBc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFEB3B"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_bcv"
                app:tint="@android:color/black" />

            <TextView
                android:id="@+id/tvDolarBc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="USD: Bs 451,51 | EUR: Bs 520,64" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/messageBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/message_bar_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvTituloScanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_verify_price"
            android:textAlignment="center"
            android:textColor="@color/blanco"
            android:textSize="50sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Overlay de resultado a pantalla completa -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/resultOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/resultCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="20dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:visibility="visible"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.90"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.90">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent">

                <TextView
                    android:id="@+id/tvResultTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_price_result"
                    android:textColor="#777777"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Sección de imagen de sede (izquierda) -->
                <FrameLayout
                    android:id="@+id/imageSection"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.40">

                    <ImageView
                        android:id="@+id/ivStoreImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/store_image_desc"
                        android:scaleType="fitXY"
                        android:src="@drawable/img_tarjeta"
                        tools:src="@drawable/img_tarjeta" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/gradient_overlay" />

                    <TextView
                        android:id="@+id/tvUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:padding="12dp"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        android:text="@string/store_default_name"
                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Línea divisoria vertical -->
                <View
                    android:id="@+id/divider"
                    android:layout_width="2dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/gradient_divider"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imageSection"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Sección de contenido (derecha) -->
                <LinearLayout
                    android:id="@+id/infoGroup"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/divider"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvNombre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rubik_semibold"
                        android:layout_marginBottom="10dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#555555"
                        android:textSize="@dimen/text_size_nombre"
                        android:textStyle="bold|italic"
                        />

                    <TextView
                        android:id="@+id/tvPriceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:letterSpacing="0.1"
                        android:fontFamily="@font/rubik_semibold"
                        android:text="@string/price_label"
                        android:textColor="#999999"
                        android:textSize="35sp"
                        android:textStyle="bold|italic"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPriceCurrency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:text="@string/currency_symbol"
                            android:textColor="@color/verde_luz"
                            android:fontFamily="@font/rubik_semibold"
                            android:textSize="50sp"
                            android:textStyle="bold|italic" />

                        <TextView
                            android:id="@+id/tvPrecioDolar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/verde_luz"
                            android:fontFamily="@font/rubik_semibold"
                            android:textSize="@dimen/text_size_precio_usd"
                            android:textStyle="bold|italic" />

                    </LinearLayout>
                    <TextView
                        android:id="@+id/tvPrecioActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/rojo_luz_logo"
                        android:fontFamily="@font/rubik_semibold"
                        android:textStyle="bold|italic"
                        android:textSize="@dimen/text_size_precio_bs" />

                    <TextView
                        android:id="@+id/tvIva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:textStyle="bold|italic"
                        android:textColor="#555555"
                        android:textSize="30sp" />

                </LinearLayout>

                <!-- CONTENEDOR DE OFERTA: todos los elementos de oferta en un LinearLayout vertical -->
                <LinearLayout
                    android:id="@+id/ofertaGroup"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:background="@color/oferta_yellow"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@id/divider"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tvFestivalPrecios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_festival_label"
                        android:fontFamily="@font/rubik_semibold"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="@string/festival_de"
                        android:textAllCaps="true"
                        android:textColor="@color/blanco"
                        android:textSize="@dimen/text_size_festival"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:id="@+id/tvNombreOferta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:gravity="center"
                        android:textColor="@color/oferta_text_black"
                        android:textSize="@dimen/text_size_nombre_oferta"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textStyle="bold|italic"
                        />

                    <TextView
                        android:id="@+id/tvTotalRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:text="@string/total_ref"
                        android:textColor="@color/oferta_text_black"
                        android:textSize="30sp"
                        android:textStyle="bold|italic" />

                    <TextView
                        android:id="@+id/tvPrecioOferta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="4dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:textColor="@color/oferta_text_black"
                        android:textSize="@dimen/text_size_precio_oferta"
                        android:textStyle="bold|italic" />
                    <TextView
                        android:id="@+id/tvPrecioBsOferta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/oferta_text_black"
                        android:textSize="@dimen/text_size_precio_bs_oferta"
                        android:textStyle="bold|italic"
                        android:gravity="center"
                        android:fontFamily="@font/rubik_semibold" />

                    <TextView
                        android:id="@+id/tvIvaOferta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/rubik_semibold"
                        android:textStyle="bold|italic"
                        android:text="@string/iva_incluido"
                        android:textColor="@color/oferta_text_black"
                        android:textSize="30sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvOferta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/bg_oferta"
            android:padding="8dp"
            android:text="@string/oferta"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/standbyOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@color/negro"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/standbyImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:visibility="gone" />

        <VideoView
            android:id="@+id/standbyVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>